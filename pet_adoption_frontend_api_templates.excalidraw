      "index": "a2k",
      "text": "Public: GET /, /health, /ready, /version\nPublic: POST /auth/signup, POST /auth/login\nJWT: GET /auth/profile\nJWT: GET/PATCH /users/profile\nADMIN/MANAGER: GET/PATCH/DELETE /users and /users/:id\nPublic: GET /pets, GET /pets/:id\nADMIN/MANAGER/EMPLOYEE: POST/PATCH/DELETE /pets\nADMIN/MANAGER/EMPLOYEE/VET: medical reads\nADMIN/MANAGER/VET: medical entry create/update/delete\nShared constants also name: /auth/register, /auth/logout, /auth/refresh, /pets/search, /medical/records, /medical/records/:id",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 262,
      "containerId": null,
      "originalText": "Public: GET /, /health, /ready, /version\nPublic: POST /auth/signup, POST /auth/login\nJWT: GET /auth/profile\nJWT: GET/PATCH /users/profile\nADMIN/MANAGER: GET/PATCH/DELETE /users and /users/:id\nPublic: GET /pets, GET /pets/:id\nADMIN/MANAGER/EMPLOYEE: POST/PATCH/DELETE /pets\nADMIN/MANAGER/EMPLOYEE/VET: medical reads\nADMIN/MANAGER/VET: medical entry create/update/delete\nShared constants also name: /auth/register, /auth/logout, /auth/refresh, /pets/search, /medical/records, /medical/records/:id",
      "lineHeight": 1.25,
      "autoResize": true
    },
