      "link": null,
      "locked": false,
      "text": "Authentication\nPOST /auth/login\n1. user sends email + password\n2. AuthService checks users table + bcrypt\n3. JWT is returned as accessToken\n4. protected routes need Authorization: Bearer <token>",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 120,
      "containerId": null,
      "originalText": "Authentication\nPOST /auth/login\n1. user sends email + password\n2. AuthService checks users table + bcrypt\n3. JWT is returned as accessToken\n4. protected routes need Authorization: Bearer <token>",
      "lineHeight": 1.25,
      "index": "aO",
      "autoResize": true
    },
