      "updated": 1781950856371,
      "link": null,
      "locked": false,
      "text": "Pets Module\nGET /pets supports search, species, breed, status, health, minAge, maxAge\nGET /pets/:id returns pet with images, medicalRecord, vaccinations\nPOST /pets maps DTO name -> database pet_name\nPATCH /pets/:id edits allowed fields\nDELETE /pets/:id removes pet and cascades children",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 155,
      "containerId": null,
      "originalText": "Pets Module\nGET /pets supports search, species, breed, status, health, minAge, maxAge\nGET /pets/:id returns pet with images, medicalRecord, vaccinations\nPOST /pets maps DTO name -> database pet_name\nPATCH /pets/:id edits allowed fields\nDELETE /pets/:id removes pet and cascades children",
