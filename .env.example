# Application environment
NODE_ENV=development

# PostgreSQL database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pet_adoption
POSTGRES_USER=pet_adoption_user
POSTGRES_PASSWORD=change_me

# Application ports
PORT=3000
FRONTEND_HTTPS_PORT=8443

# Application URLs
FRONTEND_URL=https://localhost:8443
VITE_API_BASE_URL=/api
# JWT authentication
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_another_long_random_value
JWT_REFRESH_EXPIRES_IN=7d

#first port for the postgres database
#second port for the backend server
#third port for the frontend server
#JWT_SECRET is used for signing and verifying JSON Web Tokens (JWTs) in the auth process

# Email
MAIL_USER=petadoptionsystem2000@gmail.com
MAIL_PASSWORD=some_email_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Docker host paths used by cAdvisor.
# Rootful Docker commonly uses these defaults.
# Rootless Docker users should override them in their local .env file.
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_ROOT_DIR=/var/lib/docker

# cAdvisor runtime socket.
# Rootless Docker users should override this path locally.
DOCKER_CONTAINERD_SOCKET_PATH=/run/containerd/containerd.sock