# Application environment
NODE_ENV=development

# PostgreSQL database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pet_adoption
POSTGRES_USER=pet_adoption_user
POSTGRES_PASSWORD=change_me

# Application ports
PORT=3000
FRONTEND_HTTPS_PORT=8443

# Application URLs
FRONTEND_URL=https://localhost:8443
VITE_API_BASE_URL=http://localhost:3000

# JWT authentication
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_another_long_random_value
JWT_REFRESH_EXPIRES_IN=7d

#first port for the postgres database
#second port for the backend server
#third port for the frontend server
#JWT_SECRET is used for signing and verifying JSON Web Tokens (JWTs) in the auth process

# Email
MAIL_USER=petadoptionsystem2000@gmail.com
MAIL_PASSWORD=some_email_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback